# Copia a .env y rellena. Nunca versiones .env.
# JWT_SECRET debe tener al menos 32 bytes aleatorios. Cómo generarlo:
#   Linux/macOS/Git Bash : openssl rand -base64 48
#   Windows (PowerShell) : [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
#   Cualquier SO (Node)  : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=examen-ecommerce
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
CORS_ALLOWED_ORIGIN=http://localhost:4200
# Pon false solo si sirves la API por HTTP en local (la cookie de refresh perdería Secure).
COOKIE_SECURE=false
